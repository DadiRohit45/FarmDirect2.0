# ==============================================================================
# FarmDirect 2.0 — Backend Environment Configuration Template (Render)
# ==============================================================================
# Copy this file to backend/.env for local development or configure these in
# the Render Dashboard -> Web Service -> Environment Variables.

# 1. Django Core Security
# Source: Generate a unique, unpredictable 50+ character secret string for production
# Generate via: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-for-production

# 2. Debug Mode
# Development: True
# Production (Render): False
DJANGO_DEBUG=False

# 3. Allowed Hosts
# Source: Comma-separated domains permitted to serve this Django backend
# In Render: Include 'localhost,127.0.0.1,.onrender.com' and your custom domain if applicable
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# 4. CORS Allowed Origins
# Source: Comma-separated frontend domains permitted to make cross-origin API calls
# In Render: Include your local Vite server and your deployed Vercel domain
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# 5. CSRF Trusted Origins
# Source: Comma-separated frontend origins trusted for state-modifying requests
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# 6. Supabase Cloud Integration
# Source: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# 7. Production Database Connection (Optional / Recommended)
# Source: Render PostgreSQL Database or external PostgreSQL connection string
# Format: postgresql://username:password@hostname:5432/database_name
# If omitted or left empty, Django safely defaults to internal SQLite (backend/db.sqlite3)
DATABASE_URL=

# 8. Google Gemini AI API Key (Optional)
# Source: Google AI Studio (https://aistudio.google.com/)
# Securely stored on backend server to power /api/ai/gemini/ without exposing keys to client browsers
GEMINI_API_KEY=
