# ==============================================================================
# FarmDirect 2.0 — Frontend Environment Configuration Template (Vercel)
# ==============================================================================
# Copy this file to .env for local development or configure these in Vercel:
# Project Settings -> Environment Variables.

# 1. Supabase Cloud Configuration
# Source: Supabase Dashboard (https://supabase.com/dashboard)
# -> Project Settings -> API -> Project URL & Project API Keys (anon / public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Django Backend API URL
# Local Development: http://127.0.0.1:8000
# Production on Vercel: Your Render Web Service URL (e.g., https://farmdirect-backend.onrender.com)
VITE_DJANGO_API_URL=http://127.0.0.1:8000

# 3. Google Gemini AI Assistant
# Note: AI requests are proxied securely through the Django backend (/api/ai/gemini/)
# so that private API keys are NEVER exposed in client browser bundles.
# Set GEMINI_API_KEY on your Django backend (Render) instead.
VITE_GEMINI_MODEL=gemini-1.5-flash
